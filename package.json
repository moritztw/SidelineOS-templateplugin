  "version": "0.1.0",
  "description": "Minimales, lauffähiges Plugin-Template für SidelineOS-Core (dev)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/moritztw/SIdelineOS-templateplugin.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
